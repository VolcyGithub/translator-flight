{
    "name": "volcy/translator-flight",
    "description": "FlightPHP bridge for volcy/translator: a BladeOne wrapper, translation middleware, and Runway commands.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "flightphp",
        "translation",
        "i18n",
        "blade",
        "bladeone"
    ],
    "authors": [
        {
            "name": "Yowensly Volcy",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VolcyGithub/translator-core.git",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.0",
        "volcy/translator-core": "dev-main",
        "flightphp/core": "^3.0",
        "eftec/bladeone": "^4.0"
    },
    "suggest": {
        "flightphp/runway": "Required to use the translator:scan and translator:build CLI commands"
    },
    "require-dev": {
        "flightphp/runway": "^1.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Volcy\\Translator\\Flight\\": "src/",
            "Volcy\\Translator\\Flight\\Commands\\": "src/commands/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Volcy\\Translator\\Flight\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}