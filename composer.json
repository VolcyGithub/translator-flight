{
    "name": "volcy/translator-flight",
    "description": "FlightPHP bridge for volcy/translator-core: a BladeOne wrapper, translation middleware, and Runway commands.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "flightphp",
        "translation",
        "i18n",
        "blade",
        "bladeone",
        "multilingual"
    ],
    "authors": [
        {
            "name": "Yowensly Volcy",
            "email": "svolcy12@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/VolcyGithub/translator-flight",
    "support": {
        "issues": "https://github.com/VolcyGithub/translator-flight/issues",
        "source": "https://github.com/VolcyGithub/translator-flight",
        "docs": "https://github.com/VolcyGithub/translator-flight/blob/main/README.md",
        "security": "https://github.com/VolcyGithub/translator-core/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.0",
        "eftec/bladeone": "^4.0",
        "flightphp/core": "^3.0",
        "volcy/translator-core": "^1.0"
    },
    "suggest": {
        "flightphp/runway": "Required to use the translator:scan and translator:build CLI commands"
    },
    "require-dev": {
        "flightphp/runway": "^1.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Volcy\\Translator\\Flight\\": "src/",
            "Volcy\\Translator\\Flight\\Commands\\": "src/commands/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Volcy\\Translator\\Flight\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
